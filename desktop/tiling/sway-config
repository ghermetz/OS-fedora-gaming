# ═══ fedora-gaming — Sway « mode Windows » ═══════════════════════════════
# Toutes les fenêtres sont flottantes par défaut + barre des tâches waybar
# en bas : l'usage le plus proche de Windows qu'un WM Wayland puisse offrir.

set $mod Mod4
set $term konsole

font pango:Noto Sans 10

# Clavier FR + souris sans accélération (précision en jeu)
input type:keyboard {
    xkb_layout fr
}
input type:pointer {
    accel_profile flat
}

# ── Mode Windows : tout flottant ──────────────────────────────────────────
for_window [app_id=".*"] floating enable
for_window [class=".*"] floating enable
for_window [title=".*"] floating enable
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
gaps inner 0
gaps outer 0

# ── Démarrage ─────────────────────────────────────────────────────────────
exec waybar
exec mako
exec /usr/lib/polkit-kde-authentication-agent-1
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# ── Raccourcis (Super = touche Windows) ───────────────────────────────────
bindsym $mod+Return exec $term
bindsym $mod+d exec wofi --show drun --insensitive
bindsym $mod+e exec dolphin
bindsym $mod+g exec steam
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f floating toggle
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaymsg exit

# Déplacement au clavier
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

# Captures d'écran (sélection à la souris)
bindsym Print exec sh -c 'mkdir -p ~/Pictures/Screenshots && grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%s).png'

# Volume
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# ── Barre des tâches : waybar s'en occupe, swaybar désactivée ────────────
bar {
    mode invisible
}
