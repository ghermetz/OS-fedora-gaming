// ═══ fedora-gaming — Niri (tiling défilant) ══════════════════════════════
// Session bonus : les fenêtres vivent dans une bande horizontale défilante.
// Barre des tâches waybar en bas + raccourcis à la Windows pour le confort.

input {
    keyboard {
        xkb {
            layout "fr"
        }
    }
    mouse {
        accel-profile "flat"      // pas d'accélération : précision en jeu
    }
    touchpad {
        tap true
    }
}

// Démarrage
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP=niri"

layout {
    gaps 8
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
    border {
        on
        width 2
        active-color "#e50914"
        inactive-color "#3a3a46"
    }
    default-column-width { proportion 0.5; }
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

binds {
    Mod+Return { spawn "konsole"; }
    Mod+D { spawn "wofi" "--show" "drun"; }
    Mod+E { spawn "dolphin"; }
    Mod+G { spawn "steam"; }
    Mod+Q { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Print { screenshot; }
    Mod+Shift+S { show-hotkey-overlay; }
    Mod+Shift+E { quit; }

    // Focus / déplacement
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    // Espaces de travail (bureaux virtuels)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
}
