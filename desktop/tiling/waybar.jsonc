// fedora-gaming — barre des tâches « façon Zorin OS » (session Niri)
//   Gauche : menu Démarrer · vue des tâches · applis épinglées | fenêtres ouvertes
//   Droite : média · perfs · GameMode · mises à jour · zone de notification ·
//            éclairage nocturne · anti-veille · volume · éteindre · heure ·
//            notifications · « Afficher le bureau »
// Les modules sont définis dans modules.jsonc. Pour une barre allégée sur un
// second écran, ajouter un 2e bloc avec "output" (voir « niri msg outputs »).
[
    {
        "include": "~/.config/waybar/modules.jsonc",
        "layer": "top",
        "position": "bottom",
        "height": 48,
        "spacing": 2,
        "modules-left": ["image#start", "custom/taskview", "group/epingles", "wlr/taskbar"],
        "modules-center": [],
        "modules-right": ["mpris", "custom/perf", "custom/gamemode", "custom/maj", "tray",
                          "custom/nuit", "idle_inhibitor", "pulseaudio", "custom/power",
                          "clock", "custom/notification", "custom/desktop"]
    }
]
